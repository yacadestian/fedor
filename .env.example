TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
CH_HOST=localhost
CH_PORT=8123
CH_DATABASE=health_analytics
CH_USER=health_bot
CH_PASSWORD=your_secure_password
USDA_API_KEY=DEMO_KEY

# ── LLM provider ──
# LLM_PROVIDER=deepseek          # deepseek | claude (default: auto)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_FAST=deepseek-v4-flash     # extraction, classification, OCR cleanup
# DEEPSEEK_MODEL_SMART=deepseek-v4-pro      # Q&A, health profile, digests
# DEEPSEEK_THINKING=fast=disabled,smart=enabled
# ── Vision OCR (OpenAI-compatible: Gemini / OpenRouter / OpenAI / DashScope) ──
# OCR_VISION_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# OCR_VISION_API_KEY=            # Gemini: aistudio.google.com API key (free tier)
# OCR_VISION_API_MODEL=gemini-2.5-flash-lite
# OCR_VISION_API_MODEL_FAST=gemini-2.5-flash-lite
# OCR_BACKEND=auto               # auto | vision_api | vision  (tesseract forbidden)
# OCR_CLEANUP=1                  # LLM post-correction of OCR text

# ── Voice messages (optional, needs: pip install faster-whisper) ──
# VOICE_STT=auto                 # auto | off
# WHISPER_MODEL=small            # tiny | base | small | medium

# ── Yandex Disk sync (optional, WebDAV) ──
# YANDEX_DISK_TOKEN=             # OAuth token, or use login+app password:
# YANDEX_DISK_LOGIN=
# YANDEX_DISK_PASSWORD=
# YANDEX_DISK_DIR=/healthbot

# ── Mail scan for history import (IMAP, app password) ──
# MAIL_HOST=imap.yandex.ru       # auto-detected from login domain when unset
# MAIL_LOGIN=you@yandex.ru
# MAIL_PASSWORD=                 # app password, NOT your main password
# MAIL_SINCE_YEARS=5
# MAIL_FOLDERS=INBOX,Чеки
